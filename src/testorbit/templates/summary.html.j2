<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>TestOrbit Report</title>
    <style>
      :root {
        --bg: #f6f7f9;
        --card: #ffffff;
        --text: #1f2933;
        --muted: #52606d;
        --passed: #2f9e44;
        --failed: #e03131;
        --border: #d9e2ec;
      }
      body {
        margin: 2rem auto;
        max-width: 880px;
        font-family: Segoe UI, sans-serif;
        color: var(--text);
        background: var(--bg);
      }
      h1 { margin-bottom: 0.25rem; }
      .lede { color: var(--muted); margin-top: 0; }
      .cards {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin: 1.5rem 0;
      }
      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 1rem;
      }
      .card h2 {
        margin: 0;
        font-size: 0.9rem;
        color: var(--muted);
        font-weight: 600;
      }
      .card p {
        margin: 0.35rem 0 0;
        font-size: 2rem;
        font-weight: 700;
      }
      .card.passed p { color: var(--passed); }
      .card.failed p { color: var(--failed); }
      .card.flaky p { color: #f08c00; }
      .chart {
        display: flex;
        height: 16px;
        background: var(--border);
        border-radius: 999px;
        overflow: hidden;
        margin-bottom: 1.5rem;
      }
      .bar.passed { background: var(--passed); }
      .bar.failed { background: var(--failed); }
      table {
        width: 100%;
        border-collapse: collapse;
        background: var(--card);
        border: 1px solid var(--border);
      }
      th, td {
        text-align: left;
        padding: 0.7rem 0.9rem;
        border-bottom: 1px solid var(--border);
      }
      th { color: var(--muted); font-size: 0.85rem; }
      tr.passed td:nth-child(2) { color: var(--passed); }
      tr.failed td:nth-child(2) { color: var(--failed); }
      .flaky-hint {
        background: #fff4e6;
        border: 1px solid #ffd8a8;
        border-radius: 8px;
        padding: 0.8rem 1rem;
        margin-bottom: 1.5rem;
      }
      tr.flaky td:first-child::after {
        content: " flaky";
        color: #f08c00;
        font-size: 0.8rem;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <h1>TestOrbit Summary</h1>
    <p class="lede">{{ passed }} passed, {{ failed }} failed across {{ total }} runs</p>
    <section class="cards">
      <article class="card total">
        <h2>Total runs</h2>
        <p>{{ total }}</p>
      </article>
      <article class="card passed">
        <h2>Passed</h2>
        <p>{{ passed }}</p>
      </article>
      <article class="card failed">
        <h2>Failed</h2>
        <p>{{ failed }}</p>
      </article>
      <article class="card flaky">
        <h2>Flaky tasks</h2>
        <p>{{ flaky_count }}</p>
      </article>
    </section>
    <div class="chart" role="img" aria-label="{{ passed }} passed, {{ failed }} failed">
      <div class="bar passed" style="width: {{ pass_percent }}%"></div>
      <div class="bar failed" style="width: {{ fail_percent }}%"></div>
    </div>
    {% if flaky_tasks %}
    <p class="flaky-hint">Repeated failures (2+): {{ flaky_tasks | join(", ") }}</p>
    {% endif %}
    <table>
      <thead>
        <tr>
          <th>Task</th>
          <th>Result</th>
          <th>Duration</th>
        </tr>
      </thead>
      <tbody>
        {% for record in records %}
        <tr class="{{ record.status }}{% if record.task_name in flaky_tasks %} flaky{% endif %}">
          <td>{{ record.task_name }}</td>
          <td>{{ record.status | capitalize }}</td>
          <td>{{ record.duration_display }}</td>
        </tr>
        {% else %}
        <tr>
          <td colspan="3">No recorded runs.</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </body>
</html>
