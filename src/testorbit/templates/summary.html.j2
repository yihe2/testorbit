<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>TestOrbit Report</title>
  </head>
  <body>
    <h1>TestOrbit Summary</h1>
    <p>{{ passed }} passed, {{ failed }} failed, {{ total }} total</p>
    <section class="cards">
      <article class="card total">
        <h2>Total</h2>
        <p>{{ total }}</p>
      </article>
      <article class="card passed">
        <h2>Passed</h2>
        <p>{{ passed }}</p>
      </article>
      <article class="card failed">
        <h2>Failed</h2>
        <p>{{ failed }}</p>
      </article>
    </section>
    <table>
      <thead>
        <tr>
          <th>Task</th>
          <th>Status</th>
          <th>Duration</th>
        </tr>
      </thead>
      <tbody>
        {% for record in records %}
        <tr>
          <td>{{ record.task_name }}</td>
          <td>{{ record.status }}</td>
          <td>{{ record.duration_seconds }}s</td>
        </tr>
        {% else %}
        <tr>
          <td colspan="3">No run history found.</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </body>
</html>
